# Copy to .env.local and fill in. Never commit .env.local.
# Server-only secrets: never prefix them with NEXT_PUBLIC_.
# On Vercel: Project → Settings → Environment Variables (or `npx vercel env add NAME production`).

# AI (Google AI Studio, free tier)
GEMINI_API_KEY=
LLM_MODEL=            # copy the exact free "Flash" model name from AI Studio
LLM_PROVIDER=gemini

# Web search (dashboard.exa.ai)
EXA_API_KEY=

# Max research runs per day across all visitors (protects free tiers)
RESEARCH_DAILY_CAP=50

# Supabase (next stage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
