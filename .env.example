# Copy to .env.local and fill in. Never commit .env.local.
# Server-only secrets: never prefix them with NEXT_PUBLIC_.
# On Vercel: Project → Settings → Environment Variables (or `npx vercel env add NAME production`).
# Lines starting with "# NAME=" are optional: they have a default in the code, so leave them out unless you want to change it
# (an empty value is NOT the same as unset for those).

# --- AI (Google AI Studio, free tier) ---
# API key for the AI that reads posts and writes the cards.
GEMINI_API_KEY=
# The exact free "Flash" model name from AI Studio (the AI is off without it).
LLM_MODEL=
# Model tried when LLM_MODEL fails or is busy (default: gemini-3.5-flash-lite).
LLM_FALLBACK_MODEL=
# Which AI provider to use; only "gemini" is supported (default: gemini).
# LLM_PROVIDER=

# --- Research sources ---
# Web search (dashboard.exa.ai): finds forums, reviews and competitors across the web.
EXA_API_KEY=
# Startup revenue data for market proof and competitors (trustmrr.com → developer dashboard).
TRUSTMRR_API_KEY=
# Product Hunt developer token: adds launches to "what's working" (check their terms for commercial use).
PRODUCT_HUNT_TOKEN=
# Cloudflare Radar API token (free): adds traffic rank to "what's working" products.
CLOUDFLARE_RADAR_TOKEN=
# Optional, raises free API limits (everything works without them):
# Stack Exchange key (stackapps.com): 300 → 10,000 requests/day.
STACKEXCHANGE_KEY=
# GitHub token (github.com/settings/tokens, no scopes needed): more GitHub search requests.
GITHUB_TOKEN=

# --- Limits (protect the free tiers) ---
# Max research runs per day across all guests (default: 50).
# RESEARCH_DAILY_CAP=
# Max research runs per day across all signed-in users (default: 600).
# RESEARCH_USERS_DAILY_CAP=
# Max research runs per day for one signed-in user (default: 60).
# RESEARCH_USER_DAILY_CAP=
# Max calls per day across all visitors for the AI-only routes (defaults: 300, 300, 200).
# IDEAS_DAILY_CAP=
# INTERESTS_DAILY_CAP=
# MIND_DAILY_CAP=

# --- Daily feed job (Vercel Cron, see vercel.json) ---
# Secret the cron job sends as "Authorization: Bearer ..."; /api/cron/feed refuses to run without it.
CRON_SECRET=
# How many topics the feed researches per day, split over 3 runs (default: 10; 0 turns it off).
# FEED_DAILY_TOPICS=

# --- Supabase (accounts and storage; without it the app uses in-memory storage) ---
# Project URL.
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (older name; the newer "publishable" key works too).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only service role key (newer name: SUPABASE_SECRET_KEY).
SUPABASE_SERVICE_ROLE_KEY=
# Alternatives the code also accepts:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_URL=
